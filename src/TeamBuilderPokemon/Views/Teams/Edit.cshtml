@model EditTeamInput
@{
    ViewData["Title"] = "Editar time";
    var roster = ViewBag.Roster as List<Pokemon> ?? new List<Pokemon>();
}

<h1>Editar time</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label for="Name" class="form-label fw-semibold">Nome do time</label>
            <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name" maxlength="100" required />
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="IsPublic" name="IsPublic" value="true" @(Model.IsPublic ? "checked" : "") />
                <label class="form-check-label" for="IsPublic">Time público (qualquer um com o link vê a análise)</label>
            </div>
        </div>
    </div>

    <div class="table-responsive poke-card p-2 mb-3">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>#</th><th>Pokémon</th><th>Apelido</th><th style="width: 110px;">Nível</th><th></th></tr>
            </thead>
            <tbody id="slots-body" data-max="@Team.MaxSlots">
                @foreach (var slot in Model.Slots)
                {
                    <partial name="_SlotRow" model="slot" view-data='new ViewDataDictionary(ViewData) { ["Roster"] = roster }' />
                }
            </tbody>
        </table>
    </div>

    <template id="slot-template">
        <partial name="_SlotRow" model="new EditSlotInput()" view-data='new ViewDataDictionary(ViewData) { ["Roster"] = roster }' />
    </template>

    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" id="add-slot">+ Adicionar Pokémon</button>
        <button type="submit" class="btn btn-danger">Salvar alterações</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancelar</a>
    </div>
    <p class="text-body-secondary small mt-2">A versão anterior fica guardada no histórico do time, dá pra voltar depois.</p>
</form>

<partial name="_ImportPokemon" model="(int?)Model.Id" />
