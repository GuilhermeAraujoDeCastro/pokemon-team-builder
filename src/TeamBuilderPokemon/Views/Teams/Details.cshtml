@model Team
@{
    ViewData["Title"] = $"Time: {Model.Name}";
    var revisions = ViewBag.Revisions as List<TeamRevision> ?? new List<TeamRevision>();
    var shareUrl = ViewBag.ShareUrl as string;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <div>
        <h1 class="mb-0">@Model.Name</h1>
        <p class="text-body-secondary mb-0">Criado em @Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="d-flex flex-wrap gap-2 no-print">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
        <a asp-action="Battle" asp-route-id="@Model.Id" class="btn btn-warning">⚔ Batalhar</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()" title="Abre a impressão; escolha 'Salvar como PDF'">🖨 Salvar PDF</button>
    </div>
</div>

@if (Model.IsPublic && shareUrl is not null)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 no-print">
        <span>Este time é público:</span>
        <a href="@shareUrl" class="text-break">@shareUrl</a>
        <button type="button" class="btn btn-sm btn-info" data-copy="@shareUrl">Copiar link</button>
    </div>
}

<partial name="_TeamMembers" model="Model" />
<partial name="_Analysis" model="ViewBag.Analysis as TeamAnalysisResult" />

@if (revisions.Any())
{
    <h2 class="h4 mt-4">Histórico de versões</h2>
    <p class="text-body-secondary small">Cada edição guarda como o time estava antes. Restaurar também guarda a versão atual.</p>
    <ul class="list-group mb-3 no-print">
        @foreach (var revision in revisions)
        {
            var snapshot = revision.ReadSnapshot();
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><strong>@revision.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong> · "@snapshot.Name" com @snapshot.Slots.Count Pokémon</span>
                <form asp-action="RestoreRevision" asp-route-id="@Model.Id" asp-route-revisionId="@revision.Id" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Restaurar</button>
                </form>
            </li>
        }
    </ul>
}

<a asp-action="Index" class="btn btn-secondary mt-3 no-print">Voltar</a>
