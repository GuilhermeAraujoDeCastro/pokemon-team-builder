@{
    ViewData["Title"] = "Criar equipe";
    var roster = ViewBag.Roster as List<Pokemon> ?? new List<Pokemon>();
}

<h1>Criar equipe</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group mb-3">
        <label for="name">Nome da equipe</label>
        <input type="text" class="form-control" id="name" name="name" maxlength="100" required />
    </div>

    <p>Escolha ate 6 Pokemon (a ordem que voce marcar vira a ordem dos slots):</p>

    <div class="row">
        @foreach (var pokemon in roster)
        {
            <div class="col-md-3 col-sm-4 col-6 mb-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="pokemonIds" value="@pokemon.Id" id="pkm-@pokemon.Id" />
                    <label class="form-check-label" for="pkm-@pokemon.Id">
                        @pokemon.Name
                        <br />
                        <small class="text-muted">@string.Join("/", pokemon.GetTypes())</small>
                    </label>
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary mt-3">Salvar equipe</button>
</form>
