@{
    ViewData["Title"] = "Início";
}

<section class="hero text-center mb-4">
    <h1 class="display-5 fw-bold"><span class="pokeball" aria-hidden="true"></span>Team Builder Pokémon</h1>
    <p class="lead mx-auto" style="max-width: 640px;">
        Monte um time de até 6 Pokémon e veja na hora quais tipos de ataque são fraqueza ou resistência do time inteiro,
        com sugestões de quem colocar pra cobrir os buracos.
    </p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Teams" asp-action="Index" class="btn btn-warning btn-lg fw-semibold">Ver meus times</a>
    }
    else
    {
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-warning btn-lg fw-semibold">Criar conta</a>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg">Entrar</a>
    }
</section>

<div class="row g-3">
    <div class="col-md-4">
        <div class="poke-card p-3 h-100">
            <h2 class="h5">Catálogo que cresce</h2>
            <p class="mb-0">Começa com 36 Pokémon cobrindo os 18 tipos, e qualquer outro pode ser importado da PokeAPI pelo nome.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="poke-card p-3 h-100">
            <h2 class="h5">Análise automática</h2>
            <p class="mb-0">Cada time é avaliado contra os 18 tipos de ataque, com sugestões que cobrem duas fraquezas de uma vez.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="poke-card p-3 h-100">
            <h2 class="h5">Batalha simulada</h2>
            <p class="mb-0">Coloque dois times pra lutar com a mesma fórmula de dano do meu Simulador de Batalha em Python.</p>
        </div>
    </div>
</div>
